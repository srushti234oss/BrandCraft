# Mock mode is the safe default. It never calls Gemini and needs no API key.
AI_MODE=mock
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set these only when deliberately testing live Gemini later.
# AI_MODE=gemini
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Use a long random value before any public deployment.
# DJANGO_SECRET_KEY=replace_me_with_a_long_random_value
